# LORE production environment. Copy to /srv/lore/.env on the server, fill in,
# then `chmod 600 /srv/lore/.env`. Never commit the filled-in file.
# docs/deploy/server.md says how to make each secret; docs/deploy/auth-setup.md
# how to get the sign-in credentials.
#
# Set by deploy/compose.yaml itself, so NOT here: LORE_MULTI_USER=1,
# LORE_TRUST_PROXY=1, LORE_DATA_DIR=/data, LORE_OLLAMA_HOST=http://ollama:11434
# and LORE_DATABASE_URL (built from POSTGRES_PASSWORD below).

# --- Compose -----------------------------------------------------------------
# Starts cloudflared with the rest. Leave it set on the server.
COMPOSE_PROFILES=tunnel
# The image the stack runs; deploy/update.sh passes the commit it built, so
# this is only the fallback for hand-run compose commands.
# LORE_IMAGE_TAG=latest
# The adopted Ollama: its image (as `docker inspect ollama --format
# '{{.Config.Image}}'` shows it before adoption), container and volume names.
OLLAMA_IMAGE=ollama/ollama:latest
# OLLAMA_CONTAINER_NAME=ollama
# OLLAMA_VOLUME=ollama

# --- Postgres (the central database) -----------------------------------------
# URL-safe, since it goes into a connection URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Cloudflare Tunnel --------------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in its install
# command (the long string after --token). Mapped to cloudflared's TUNNEL_TOKEN.
CLOUDFLARE_TUNNEL_TOKEN=

# --- The public site -----------------------------------------------------------
LORE_BASE_URL=https://lore.jrvn.site
# Secrets, at least 32 characters each; the two must differ. Make each with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
LORE_SESSION_SECRET=
LORE_CSRF_SECRET=
# Seals every user's stored AI key. Make it with:
#   docker compose ... run --rm --no-deps web lore admin generate-master-key
# Losing it loses every stored key (users re-enter theirs). Back it up apart
# from the server.
LORE_KEY_ENCRYPTION_KEY=
# Only while rotating the master key (lore admin rotate-keys), then remove.
# LORE_KEY_ENCRYPTION_KEY_OLD=
# Invite-only sign-up (the default in multi mode). Keep it on for the beta.
# LORE_INVITE_ONLY=1
# Secure cookies are on by default and need an https LORE_BASE_URL. Never 0 here.
# LORE_COOKIE_SECURE=1

# --- Sign-in providers: each switches on when its pair is set ----------------
LORE_GOOGLE_CLIENT_ID=
LORE_GOOGLE_CLIENT_SECRET=
# GitHub is optional.
LORE_GITHUB_CLIENT_ID=
LORE_GITHUB_CLIENT_SECRET=

# --- Email sign-in links (Resend) ---------------------------------------------
LORE_RESEND_API_KEY=
LORE_MAIL_FROM=LORE <login@jrvn.site>

# --- Limits (defaults shown; uncomment to change) -----------------------------
# Uploads and library size
# LORE_UPLOADS_PER_DAY=10
# LORE_UPLOADS_PER_HOUR=30
# LORE_MAX_BOOKS=30
# Questions, per user and across the server
# LORE_ASK_PER_MINUTE=6
# LORE_ASK_IN_FLIGHT_PER_USER=1
# LORE_ASK_IN_FLIGHT=8
# LORE_INTRO_PER_HOUR=60
# LORE_REPORTS_PER_HOUR=20
# Upload parsing (sandboxed subprocess in the web container)
# LORE_PARSES_IN_FLIGHT=2
# LORE_PARSE_CPU_SECONDS=60
# LORE_PARSE_MEMORY_MB=1024
# LORE_PARSE_TIMEOUT_SECONDS=120
# Hosted MCP (/mcp)
# LORE_MCP_PER_MINUTE=30
# LORE_MCP_PER_MINUTE_PER_USER=60
# Traces kept per user (also expire after 30 days)
# LORE_TRACES_PER_USER=2000
# Ask before a paid-provider job estimated above this many US dollars
# LORE_CONFIRM_ABOVE_USD=1.0

# --- Backups (deploy/backup.sh) ------------------------------------------------
# Local backups land in /srv/lore/backups (7 daily, 4 weekly). Set all four
# R2 values to also copy each backup to Cloudflare R2 with rclone.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lore-backups
