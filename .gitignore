# runtime state — never commit
data/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# secrets — belt and braces
.env
kaggle.json

# editors / os
.vscode/
.idea/
.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# lore ui: built frontend and node artefacts
lore/web/static/*
!lore/web/static/.gitkeep
web/node_modules/
web/test-results/
web/playwright-report/
